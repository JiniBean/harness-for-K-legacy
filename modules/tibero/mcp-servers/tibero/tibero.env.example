# Tibero MCP accounts. Keys only: the user copies this to <secrets_dir>/<project>/tibero.env
# and fills the values. Agents never read or write that file.
# <ENV> = each key of harness.toml [tibero.profiles] (uppercase). Per-env keys win over the common ones.

TIBERO_USER=
TIBERO_PASSWORD=

# one pair per env, e.g. DEV / TEST
TIBERO_USER_DEV=
TIBERO_PASSWORD_DEV=
TIBERO_USER_TEST=
TIBERO_PASSWORD_TEST=
